PORT=3000
# Comma-separated list of frontend origins allowed to call the API.
CORS_ORIGIN=http://localhost:8080
# Set when running behind a proxy/load balancer (number of hops) so rate limiting sees client IPs.
TRUST_PROXY=0

# Optional prediction logging. Leave unset to run without a database.
# DATABASE_URL=postgres://analyzer:analyzer@localhost:5432/analyzer
# Enables GET /api/analyzer-log with "Authorization: Bearer <token>".
# ADMIN_TOKEN=
