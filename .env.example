# Google Maps JavaScript API key with the Places library enabled.
# Restrict it to your domains (HTTP referrers) in Google Cloud Console.
VITE_GOOGLE_MAPS_API_KEY=
# Base URL of the prediction API. Leave empty when the API is on the same origin
# (Vercel via vercel.json, or development where Vite proxies /api to localhost:3000).
VITE_API_BASE_URL=
